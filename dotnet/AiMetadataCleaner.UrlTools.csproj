<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>AiMetadataCleaner.UrlTools</PackageId>
    <Version>0.1.0</Version>
    <Authors>wangneo276-lgtm</Authors>
    <Description>Offline URL builder for AI Metadata Cleaner image, video, and PDF metadata pages. Not an official SDK.</Description>
    <PackageProjectUrl>https://aimetadatacleaner.pro/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wangneo276-lgtm/aimetadatacleaner-url-tools</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="" />
    <None Include="../LICENSE" Pack="true" PackagePath="LICENSE" />
  </ItemGroup>
</Project>
